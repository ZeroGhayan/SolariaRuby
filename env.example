# OKX (crie a chave apenas com permissão de Trade; NUNCA Withdraw; restrinja ao IP do Orange Pi)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SANDBOX=false

# xAI (Grok) via SDK OpenAI
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.3
# none|low|medium|high (grok-4.3). "none" = sem raciocínio, mais barato. Vazio = padrão da API (low)
XAI_REASONING_EFFORT=none
# o comando tem 8 caracteres; 16 tokens de folga
XAI_MAX_TOKENS=16
# preços US$ por 1M tokens (grok-4.3, docs.x.ai) para estimar o custo no log
XAI_PRICE_INPUT_PER_M=1.25
XAI_PRICE_CACHED_PER_M=0.20
XAI_PRICE_OUTPUT_PER_M=2.50
# reaproveita a mesma resposta por N segundos se a pergunta for idêntica (0 = desliga)
XAI_CACHE_SECONDS=600
# X Search ao vivo (Responses API). DESLIGADO por padrão: US$ 5 por 1.000 posts lidos + tokens
XAI_X_SEARCH=false
XAI_X_HANDLES=raicher,DollynhoCoin
XAI_X_SEARCH_MAX_TURNS=1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_MAIN=
TELEGRAM_CHAT_ID_DEBUG=

# X/Twitter (opcional; deixe vazio para desativar)
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=allanraicher
TWITTER_HASHTAG=#nostreidamos

# Operação
TRADING_PAIRS=BTC/BRL
DRY_RUN=true
# a cada 4 h (14400 s). Se SCHEDULE_TIMES for preenchido, ele tem prioridade.
INTERVAL_SECONDS=14400
# opcional: horários fixos locais, ex. 8 horários do README antigo:
# SCHEDULE_TIMES=01:00,04:00,07:00,10:00,13:00,16:00,19:00,22:00
SCHEDULE_TIMES=
SAFETY_MARGIN=0.05
LOG_LEVEL=INFO
