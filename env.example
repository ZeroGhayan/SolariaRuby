# OKX (crie a chave apenas com permissão de Trade; NUNCA Withdraw; restrinja ao IP do Orange Pi)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SANDBOX=false

# xAI (Grok) via SDK OpenAI — opcional na estratégia local (só a revisão semanal usa)
XAI_API_KEY=
XAI_MODEL=grok-4.3
# none|low|medium|high (grok-4.3). "none" = sem raciocínio, mais barato. Vazio = padrão da API (low)
XAI_REASONING_EFFORT=none
# o comando tem 8 caracteres; 16 tokens de folga
XAI_MAX_TOKENS=16
# preços US$ por 1M tokens (grok-4.3, docs.x.ai) para estimar o custo no log
XAI_PRICE_INPUT_PER_M=1.25
XAI_PRICE_CACHED_PER_M=0.20
XAI_PRICE_OUTPUT_PER_M=2.50
# reaproveita a mesma resposta por N segundos se a pergunta for idêntica (0 = desliga)
XAI_CACHE_SECONDS=600
# só para X_SOURCE=xai: rodadas máximas de busca por chamada
XAI_X_SEARCH_MAX_TURNS=1

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_MAIN=
TELEGRAM_CHAT_ID_DEBUG=

# Posts do X (@raicher e @DollynhoCoin) — só usados com STRATEGY_MODE=grok
# X_SOURCE: off   (padrão: não lê o X; a estratégia local não precisa)
#           x_api (API oficial do X pay-per-use, US$ 0,005/post novo)
#           xai   (ferramenta x_search do Grok: US$ 0,005/post lido + tokens, relê posts a cada chamada)
X_SOURCE=off
TWITTER_BEARER_TOKEN=
X_HANDLES=raicher,DollynhoCoin
# filtro extra opcional na busca (reduz posts cobrados), ex.: #nostreidamos
X_QUERY_FILTER=
# teto de posts lidos por dia UTC (20 = no máx. US$ 0,10/dia)
X_MAX_POSTS_PER_DAY=20

# Operação
TRADING_PAIRS=BTC/BRL
DRY_RUN=true
# a cada 4 h (14400 s). Se SCHEDULE_TIMES for preenchido, ele tem prioridade.
INTERVAL_SECONDS=14400
# opcional: horários fixos locais, ex. 8 horários do README antigo:
# SCHEDULE_TIMES=01:00,04:00,07:00,10:00,13:00,16:00,19:00,22:00
SCHEDULE_TIMES=
SAFETY_MARGIN=0.05
LOG_LEVEL=INFO

# ===== Estratégia local (Allan Raicher) =====
# local (padrão: análise técnica no Orange Pi, sem IA por ciclo) | grok (modo antigo: Grok a cada ciclo)
STRATEGY_MODE=local
# memória de velas (SQLite, fora do git)
CANDLES_DB=data/candles.db
# dias de velas de 1 minuto baixados na 1ª execução (para montar 343m/686m) e quantos dias manter
MINUTE_BACKFILL_DAYS=21
MINUTE_RETENTION_DAYS=35
# histórico curto em BTC/BRL? usa BTC/USDT convertido por USDT/BRL só onde faltar (vazio desliga)
REFERENCE_SYMBOL=BTC/USDT
REFERENCE_RATE_SYMBOL=USDT/BRL
# "perto da média": fechamento até X% acima da MA (abaixo também conta)
NEAR_BAND_PCT=3
# fração do saldo livre (após SAFETY_MARGIN) por gráfico que sinalizar compra (1 gráfico=10%, 2=20%...)
BUY_FRACTION=0.10
# fração no BBB do 2D (1.0 = all in, como o Raicher)
BBB_FRACTION=1.0
# horas mínimas entre compras
BUY_COOLDOWN_HOURS=24
# true = sem velas de 343m suficientes, não compra pelas regras dos 3 gráficos
FILTER_343_REQUIRED=false
# média do RSI usada no filtro de 343m
RSI_MA_LENGTH=14
# venda (sempre total, NBRT0000): todos estes gráficos fecharam acima da MA7
SELL_ENABLED=true
SELL_TIMEFRAMES=1w,1M
# só vende com lucro mínimo sobre o preço médio das compras decididas pelo bot
SELL_REQUIRE_PROFIT=true
SELL_MIN_PROFIT_PCT=2
# mínimo da OKX para BTC
MIN_ORDER_BTC=0.0001

# Gráfico no Telegram (sendPhoto): a cada N ciclos (6 x 4 h = 1x por dia) e sempre que houver ordem
TELEGRAM_CHARTS=true
CHART_EVERY_N_CYCLES=6

# Revisão semanal do Grok (malha fechada). Dia: 0=segunda ... 6=domingo; hora local
WEEKLY_REVIEW=true
WEEKLY_REVIEW_WEEKDAY=6
WEEKLY_REVIEW_HOUR=21
