# Referência do serviço systemd para o Orange Pi 5 do Pedro.
# Já existe um serviço funcionando no Orange Pi: NÃO crie um duplicado.
# Use este arquivo só como referência para editar o serviço existente (veja o README).
[Unit]
Description=Solaria Ruby trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/dgsManager/SolariaRuby
EnvironmentFile=/home/orangepi/dgsManager/SolariaRuby/.env
ExecStart=/home/orangepi/dgsManager/SolariaRuby/venv/bin/python main.py
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
